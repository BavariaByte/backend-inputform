# Backend-Inputform Environment Variables

# MongoDB connection string.
# IMPORTANT: all GIRP services share ONE database — the database name here
# MUST be identical to the one in backend-socview/.env, otherwise this
# service will not see playbooks created in SOCView. The replicaSet
# parameter matches the shared change-stream requirement of the platform.
MONGODB_URI=mongodb://localhost:27017/girp_db?replicaSet=rs0

# Port for this service
PORT=4000
NODE_ENV=development

# Allowed CORS origins (comma-separated, must match INPUTFORM_URL)
INPUTFORM_URL=http://localhost:4173

# JWT configuration for anonymous form sessions (HS256).
# REQUIRED in production. Use a cryptographically random value (≥32 bytes).
# Generate with: openssl rand -base64 48
# Placeholder values (change-me, dev-session-secret, ...) and secrets shorter
# than 32 characters are rejected at startup in production.
# Ignored when SESSION_JWT_PRIVATE_KEY is set (see Advanced section: RS256).
SESSION_JWT_SECRET=

# Logging. LOG_LEVEL=debug enables verbose application logs (otherwise quiet
# by default; only responses with status >= 400 are logged).
LOG_LEVEL=info

# ==========================================
# SSO Auth
# ==========================================
# Requires SSO login before form access. Defaults to true (secure by default);
# when enabled, session creation and playbook routes reject unauthenticated
# requests. Set to false ONLY for local demos (e.g. the GIRP Launcher) or
# isolated test setups — never in production.
INPUTFORM_AUTH_ENABLED=true

# URL of Backend-SOCView — used for Better-Auth session validation
# and by the frontend to fetch auth config at runtime.
SOCVIEW_API_URL=http://localhost:3000

# Auth provider toggle (same vars as Backend-SOCView, shared via combined .env in Docker).
# AUTH_AZURE_ENABLED=true → tokens are verified as Entra ID JWTs via JWKS.
# AUTH_BETTERAUTH_ENABLED=true → tokens are validated against Backend-SOCView's session endpoint.
# If both are false and INPUTFORM_AUTH_ENABLED=true the service will reject all requests.
AUTH_AZURE_ENABLED=false
AUTH_BETTERAUTH_ENABLED=true

# Azure / Entra ID — only required when AUTH_AZURE_ENABLED=true.
# Must match the App Registration used by the Frontend-SOCView app.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# ==========================================
# Advanced (optional — defaults are sensible)
# ==========================================

# Max request body size (default 1mb).
# BODY_LIMIT=1mb

# LOG_FORMAT overrides the morgan format token. Defaults to "combined" in
# production and "dev" when LOG_LEVEL=debug. Common values: combined, common,
# dev, short, tiny.
# LOG_FORMAT=

# LOG_ANONYMIZE_IP=true zeros the last IPv4 octet / last 64 IPv6 bits in
# request logs (GDPR Art. 32).
# LOG_ANONYMIZE_IP=false

# Session lifetime caps (server-enforced).
# SESSION_TTL_MINUTES        — default lifetime when the client does not specify one.
# SESSION_TTL_MAX_MINUTES    — upper bound; client requests above this are clamped.
# SESSION_RESUME_MAX_MINUTES — idle timeout (max inactivity).
# SESSION_MAX_EVENTS_CAP     — hard cap on per-session events (DoS backstop).
# SESSION_TTL_MINUTES=120
# SESSION_TTL_MAX_MINUTES=480
# SESSION_RESUME_MAX_MINUTES=30
# SESSION_MAX_EVENTS_CAP=10000

# Rate limit (requests per minute per IP) on POST /api/sessions.
# SESSION_CREATE_RATE_LIMIT_PER_MIN=30

# Cookie names checked for a Better-Auth session (comma-separated). Only
# needed if Backend-SOCView uses non-default Better-Auth cookie names.
# BETTERAUTH_COOKIE_NAMES=better-auth.session_token,__Secure-better-auth.session_token

# Azure / OIDC overrides (only relevant when AUTH_AZURE_ENABLED=true).
# AZURE_AUTHORITY — override the OIDC authority URL
#   (default: https://login.microsoftonline.com/<TENANT>/v2.0/).
# OIDC_ISSUER     — fallback for AZURE_AUTHORITY (generic OIDC issuer URL).
# OIDC_JWKS_URI   — override the JWKS URI directly instead of via OIDC discovery.
# ALLOWED_TENANTS — restrict to specific tenants (comma-separated tenant IDs).
# AZURE_AUTHORITY=
# OIDC_ISSUER=
# OIDC_JWKS_URI=
# ALLOWED_TENANTS=

# RS256 session-JWT signing. Setting SESSION_JWT_PRIVATE_KEY switches signing
# from HS256 to RS256 and OVERRIDES SESSION_JWT_SECRET. If you set the private
# key you MUST also set the matching public key. PEM format, newlines as \n.
# SESSION_JWT_PRIVATE_KEY=
# SESSION_JWT_PUBLIC_KEY=

# Session-JWT claims (defaults shown). Usually no need to change.
# SESSION_JWT_ISSUER=incident-intake-backend
# SESSION_JWT_AUDIENCE=incident-intake-client
